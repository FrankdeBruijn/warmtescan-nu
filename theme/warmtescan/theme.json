{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "72rem"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "papier", "color": "#ffffff", "name": "Papier" },
				{ "slug": "papier-dof", "color": "#f4f4f4", "name": "Papier gedempt" },
				{ "slug": "inkt", "color": "#000000", "name": "Zwart" },
				{ "slug": "inkt-zacht", "color": "#5b616e", "name": "Grijs" },
				{ "slug": "accent", "color": "#ceeb4c", "name": "Limoen" },
				{ "slug": "accent-diep", "color": "#758c10", "name": "Olijf" },
				{ "slug": "lijn", "color": "#e2e4e8", "name": "Lijn" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-300.woff2" ]
						},
						{
							"fontFamily": "Montserrat",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-400.woff2" ]
						},
						{
							"fontFamily": "Montserrat",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-600.woff2" ]
						},
						{
							"fontFamily": "Montserrat",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-700.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "klein",
					"name": "Klein",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "normaal",
					"name": "Normaal",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "groot",
					"name": "Groot",
					"size": "1.125rem",
					"fluid": { "min": "1.0625rem", "max": "1.1875rem" }
				},
				{
					"slug": "kop",
					"name": "Kop",
					"size": "1.875rem",
					"fluid": { "min": "1.5rem", "max": "1.875rem" }
				},
				{
					"slug": "titel",
					"name": "Titel",
					"size": "2.8125rem",
					"fluid": { "min": "2rem", "max": "2.8125rem" }
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "Klein", "size": "1rem" },
				{ "slug": "30", "name": "Normaal", "size": "1.75rem" },
				{ "slug": "40", "name": "Ruim", "size": "2.25rem" },
				{ "slug": "50", "name": "Sectie", "size": "clamp(2.5rem, 5vw, 3.75rem)" },
				{ "slug": "60", "name": "Sectie groot", "size": "clamp(3.25rem, 7vw, 5rem)" }
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--papier)",
			"text": "var(--wp--preset--color--inkt)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--normaal)",
			"fontWeight": "300",
			"lineHeight": "1.75"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			},
			"blockGap": "var(--wp--preset--spacing--30)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--inkt)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent-diep)" }
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--titel)" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--kop)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--groot)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--inkt)",
					"text": "var(--wp--preset--color--papier)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normaal)",
					"fontWeight": "700",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"border": { "radius": "10px" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-diep)",
						"text": "var(--wp--preset--color--papier)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normaal)",
					"fontWeight": "700",
					"textDecoration": "none"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normaal)",
					"fontWeight": "500"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Kop", "area": "header" },
		{ "name": "footer", "title": "Voet", "area": "footer" }
	]
}
